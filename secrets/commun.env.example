# Modèle de variables communes à l'application.
# Copier en secrets/commun.env et remplir (fichier ignoré par git).
# Nommé commun.env.example (et non .env.example) car .claude/settings.json interdit la lecture des fichiers .env*.
# La clé API Claude n'est PAS ici : elle vient de la variable d'environnement ANTHROPIC_API_KEY, définie hors du dépôt.

# developpement | test | production (absent = production, par sécurité)
ENVIRONNEMENT=developpement
PAYS_PAR_DEFAUT=ga
JOURNAL_NIVEAU=info
DUREE_CONSERVATION_JOURS=remplacer-moi

# Application web (ADR 0015)
# supabase (production) | simulation (développement et test uniquement)
MODE_AUTH=supabase
URL_BASE_DONNEES=postgresql://serveur_application:remplacer-moi@remplacer-moi:5432/postgres
SECRET_SESSION=remplacer-moi-par-au-moins-32-caracteres-aleatoires
URL_SUPABASE=https://remplacer-moi.supabase.co
CLE_PUBLIQUE_SUPABASE=remplacer-moi
URL_PUBLIQUE=https://remplacer-moi

# Agent Professeur (ADR 0017). La clé API Claude N'EST PAS ici : variable ANTHROPIC_API_KEY, hors du dépôt.
# anthropic (réel) | simulation (développement et test uniquement)
MODE_MODELE=anthropic
MODELE_PROFESSEUR=claude-opus-5-5
EFFORT_PROFESSEUR=medium
MAX_JETONS_PROFESSEUR=16000
QUESTIONS_PAR_JOUR=40
# Racine du dépôt (prompts, packs pays) si l'application ne tourne pas dans application/
CHEMIN_DEPOT=..
