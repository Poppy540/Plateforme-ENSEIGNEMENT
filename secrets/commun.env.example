# Modèle de variables communes à l'application.
# Copier en secrets/commun.env et remplir (fichier ignoré par git).
# Nommé commun.env.example (et non .env.example) car .claude/settings.json interdit la lecture des fichiers .env*.
# La clé API Claude n'est PAS ici : elle vient de la variable d'environnement ANTHROPIC_API_KEY, définie hors du dépôt.

# developpement | test | production (absent = production, par sécurité)
ENVIRONNEMENT=developpement
PAYS_PAR_DEFAUT=ga
JOURNAL_NIVEAU=info
DUREE_CONSERVATION_JOURS=remplacer-moi

# Application web (ADR 0015)
# supabase (production) | simulation (développement et test uniquement)
MODE_AUTH=supabase
URL_BASE_DONNEES=postgresql://serveur_application:remplacer-moi@remplacer-moi:5432/postgres
SECRET_SESSION=remplacer-moi-par-au-moins-32-caracteres-aleatoires
URL_SUPABASE=https://remplacer-moi.supabase.co
CLE_PUBLIQUE_SUPABASE=remplacer-moi
URL_PUBLIQUE=https://remplacer-moi

# Agent Professeur (ADR 0017). La clé API Claude N'EST PAS ici : variable ANTHROPIC_API_KEY, hors du dépôt.
# anthropic (réel) | simulation (développement et test uniquement)
MODE_MODELE=anthropic
MODELE_PROFESSEUR=claude-opus-5-5
EFFORT_PROFESSEUR=medium
MAX_JETONS_PROFESSEUR=16000
QUESTIONS_PAR_JOUR=40
# Agent Scénariste (ADR 0022) : même MODE_MODELE
MODELE_SCENARISTE=claude-opus-5-5
EFFORT_SCENARISTE=high
MAX_JETONS_SCENARISTE=64000
SCRIPTS_PAR_CHAPITRE_PAR_JOUR=3
# Agent Évaluateur (ADR 0024) : même MODE_MODELE
MODELE_EVALUATEUR=claude-opus-5-5
EFFORT_EVALUATEUR=high
EFFORT_CORRECTION=medium
MAX_JETONS_EVALUATEUR=64000
QUIZ_PAR_CHAPITRE_PAR_JOUR=3
# Agent Tuteur (ADR 0030) : même MODE_MODELE
MODELE_TUTEUR=claude-opus-5-5
EFFORT_TUTEUR=medium
MAX_JETONS_TUTEUR=8000
PLANS_PAR_JOUR=3
TUTEUR_INACTIVITE_JOURS=14
# Agent Support/inscription (ADR 0032) : même MODE_MODELE ; quota par personne et par jour
MODELE_SUPPORT=claude-opus-5-5
EFFORT_SUPPORT=low
MAX_JETONS_SUPPORT=4000
QUESTIONS_SUPPORT_PAR_JOUR=20
# Alerte de veille (ADR 0036) : contacts de l'équipe de veille, séparés par des virgules (donnée personnelle :
# renseignée par le propriétaire dans l'environnement, jamais dans le dépôt) ; relances
CONTACTS_VEILLE=remplacer-moi
ALERTE_RELANCE_MINUTES=120
ALERTE_RELANCES_MAX=3
# Agent Coordinateur de famille (ADR 0038) : même MODE_MODELE
MODELE_COORDINATEUR=claude-opus-5-5
EFFORT_COORDINATEUR=high
MAX_JETONS_COORDINATEUR=32000
# Production vidéo (ADR 0025) : simulation (développement et test uniquement) ; aucun fournisseur réel encore.
MODE_VIDEO=simulation
# Budget par vidéo en USD : décision du propriétaire (obligatoire hors simulation).
BUDGET_VIDEO_USD=remplacer-moi
# Orchestrateur (ADR 0029) : file de tâches exécutée par un planificateur (production) ; « immediat » en développement et test.
MODE_FILE=file
# Jeton de l'exécuteur planifié (32 caractères au moins) ; absent = exécuteur désactivé.
JETON_EXECUTEUR=remplacer-moi
# Sel de pseudonymisation du journal d'audit (obligatoire hors développement et test).
SEL_AUDIT=remplacer-moi
COUT_JOUR_MAX_AGENT_USD=50
# Racine du dépôt (prompts, packs pays) si l'application ne tourne pas dans application/
CHEMIN_DEPOT=..

# Administration des données (ADR 0019) : serveur et tâche de purge UNIQUEMENT, jamais un agent.
CLE_SERVICE_SUPABASE=remplacer-moi
URL_BASE_DONNEES_ADMIN=postgresql://postgres:remplacer-moi@remplacer-moi:5432/postgres
