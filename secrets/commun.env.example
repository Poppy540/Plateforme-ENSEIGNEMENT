# Modèle de variables communes à l'application.
# Copier en secrets/commun.env et remplir (fichier ignoré par git).
# Nommé commun.env.example (et non .env.example) car .claude/settings.json interdit la lecture des fichiers .env*.
# La clé API Claude n'est PAS ici : elle vient de la variable d'environnement ANTHROPIC_API_KEY, définie hors du dépôt.

# developpement | test | production (absent = production, par sécurité)
ENVIRONNEMENT=production
PAYS_PAR_DEFAUT=ga
JOURNAL_NIVEAU=info
# Journal des erreurs (ADR 0056) : service de surveillance FACULTATIF (erreurs seulement, déjà nettoyées), en https
JOURNAL_HTTP_URL=
JOURNAL_HTTP_JETON=
DUREE_CONSERVATION_JOURS=remplacer-moi

# Application web (ADR 0015)
# supabase (production) | simulation (développement et test uniquement)
MODE_AUTH=supabase
URL_BASE_DONNEES=postgresql://serveur_application:remplacer-moi@remplacer-moi:5432/postgres
# Connexions à la base par instance (ADR 0059) ; instances × taille sous la limite de la base
TAILLE_POOL_BASE=10
SECRET_SESSION=remplacer-moi-par-au-moins-32-caracteres-aleatoires
URL_SUPABASE=https://remplacer-moi.supabase.co
CLE_PUBLIQUE_SUPABASE=remplacer-moi
URL_PUBLIQUE=https://remplacer-moi

# Agent Professeur (ADR 0017). La clé API Claude N'EST PAS ici : variable ANTHROPIC_API_KEY, hors du dépôt.
# anthropic (réel) | simulation (développement et test uniquement)
MODE_MODELE=anthropic
MODELE_PROFESSEUR=claude-opus-5-5
EFFORT_PROFESSEUR=medium
MAX_JETONS_PROFESSEUR=16000
QUESTIONS_PAR_JOUR=40
# Agent Scénariste (ADR 0022) : même MODE_MODELE
MODELE_SCENARISTE=claude-opus-5-5
EFFORT_SCENARISTE=high
MAX_JETONS_SCENARISTE=64000
SCRIPTS_PAR_CHAPITRE_PAR_JOUR=3
# Agent Évaluateur (ADR 0024) : même MODE_MODELE
MODELE_EVALUATEUR=claude-opus-5-5
EFFORT_EVALUATEUR=high
EFFORT_CORRECTION=medium
MAX_JETONS_EVALUATEUR=64000
QUIZ_PAR_CHAPITRE_PAR_JOUR=3
# Agent Tuteur (ADR 0030) : même MODE_MODELE
MODELE_TUTEUR=claude-opus-5-5
EFFORT_TUTEUR=medium
MAX_JETONS_TUTEUR=8000
PLANS_PAR_JOUR=3
TUTEUR_INACTIVITE_JOURS=14
# Agent Support/inscription (ADR 0032) : même MODE_MODELE ; quota par personne et par jour
MODELE_SUPPORT=claude-opus-5-5
EFFORT_SUPPORT=low
MAX_JETONS_SUPPORT=4000
QUESTIONS_SUPPORT_PAR_JOUR=20
# Alerte de veille (ADR 0036) : contacts de l'équipe de veille, séparés par des virgules (donnée personnelle :
# renseignée par le propriétaire dans l'environnement, jamais dans le dépôt) ; relances
CONTACTS_VEILLE=remplacer-moi
ALERTE_RELANCE_MINUTES=120
ALERTE_RELANCES_MAX=3
# Agent Coordinateur de famille (ADR 0038) : même MODE_MODELE
MODELE_COORDINATEUR=claude-opus-5-5
EFFORT_COORDINATEUR=high
MAX_JETONS_COORDINATEUR=32000
# Agent Conformité programme (ADR 0039) : même MODE_MODELE
MODELE_CONFORMITE=claude-opus-5-5
EFFORT_CONFORMITE=high
MAX_JETONS_CONFORMITE=32000
# Agent Recruteur (ADR 0040) : même MODE_MODELE ; aucun usage réel avant l'avis du juriste
MODELE_RECRUTEUR=claude-opus-5-5
EFFORT_RECRUTEUR=medium
MAX_JETONS_RECRUTEUR=8000
# Production vidéo (ADR 0025, 0055) : aucun (défaut) | reel (passerelle d'avatar + Cloudflare Stream, une fois les
# fournisseurs choisis par le propriétaire) | simulation (développement et test uniquement).
MODE_VIDEO=aucun
# Passerelle d'avatar (contrat dans docs/production/README.md §3 bis), en https
AVATAR_HTTP_URL=remplacer-moi
AVATAR_HTTP_JETON=remplacer-moi
# Tarif par minute annoncé par le fournisseur d'avatar (estimation du budget avant toute dépense)
AVATAR_COUT_MINUTE_USD=remplacer-moi
# Cloudflare Stream : compte, jeton d'API limité à Stream, sous-domaine de lecture
CLOUDFLARE_COMPTE=remplacer-moi
CLOUDFLARE_JETON_STREAM=remplacer-moi
STREAM_SOUS_DOMAINE=customer-remplacer-moi.cloudflarestream.com
# Budget par vidéo en USD : décision du propriétaire (obligatoire hors simulation).
BUDGET_VIDEO_USD=remplacer-moi
# Orchestrateur (ADR 0029) : file de tâches exécutée par un planificateur (production) ; « immediat » en développement et test.
MODE_FILE=file
# Jeton de l'exécuteur planifié (32 caractères au moins) ; absent = exécuteur désactivé.
JETON_EXECUTEUR=remplacer-moi
# Sel de pseudonymisation du journal d'audit (obligatoire hors développement et test).
SEL_AUDIT=remplacer-moi
# Sel secret de la liste d'opposition du recrutement (revue de sécurité D4) : 32 caractères aléatoires au moins,
# obligatoire hors développement et test. Ne JAMAIS le changer ensuite (les oppositions ne seraient plus reconnues).
SEL_OPPOSITION=remplacer-moi
# Durée des sessions en heures selon le rôle (revue de sécurité D6), 720 au plus
SESSION_ELEVE_HEURES=720
# (référents et enseignants de classe : même durée)
SESSION_REFERENT_HEURES=168
SESSION_ADMINISTRATION_HEURES=12
# Limites de connexion (revue de sécurité, ADR 0043) : codes envoyés par numéro ou email et par 15 minutes,
# codes envoyés par heure pour toute la plateforme, essais d'un code par 15 minutes
CODES_PAR_IDENTIFIANT=3
CODES_PAR_HEURE=200
ESSAIS_CODE=5
# Essais de code de classe ou d'invitation (référent, enseignant) par compte et par jour (ADR 0092).
ESSAIS_CODE_INVITATION=10
# Quotas des appels au modèle par élève et par jour (pris avant l'appel)
CORRECTIONS_QUIZ_PAR_JOUR=20
CONTESTATIONS_PAR_JOUR=10
QUESTIONS_PARENT_PAR_JOUR=5
COUT_JOUR_MAX_AGENT_USD=50
# Compteur de visionnage agrégé (ADR 0052) : événements comptés par élève et par jour, au plus
VISIONNAGES_PAR_JOUR=60
# Racine du dépôt (prompts, packs pays) si l'application ne tourne pas dans application/
CHEMIN_DEPOT=..

# Administration des données (ADR 0019) : serveur et tâche de purge UNIQUEMENT, jamais un agent.
CLE_SERVICE_SUPABASE=remplacer-moi
URL_BASE_DONNEES_ADMIN=postgresql://postgres:remplacer-moi@remplacer-moi:5432/postgres

# Messagerie (ADR 0045) : fournisseur par canal ; « simulation » seulement en développement et en test locaux.
# Les codes de connexion sont envoyés par Supabase (fournisseur SMS configuré dans Supabase), pas ici.
FOURNISSEUR_SMS=remplacer-moi
FOURNISSEUR_EMAIL=remplacer-moi
# Twilio (SMS)
TWILIO_COMPTE=remplacer-moi
TWILIO_JETON=remplacer-moi
SMS_EXPEDITEUR=remplacer-moi
# Brevo (email)
BREVO_CLE=remplacer-moi
EMAIL_EXPEDITEUR=remplacer-moi
EMAIL_NOM_EXPEDITEUR=remplacer-moi
# Passerelle HTTP générique (agrégateur local), en https
MESSAGERIE_HTTP_URL=remplacer-moi
MESSAGERIE_HTTP_JETON=remplacer-moi
