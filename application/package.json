{
  "name": "plateforme-enseignement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:verifier": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:base": "bash scripts/tester-base.sh",
    "test:sauvegarde": "bash scripts/tester-sauvegarde.sh",
    "base:sauvegarder": "bash scripts/sauvegarde-base.sh sauvegarder",
    "base:restaurer": "bash scripts/sauvegarde-base.sh restaurer",
    "pack:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pack-en-sql.mts",
    "referent:invitation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/invitation-referent.mts",
    "test:agents": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lancer-tests-agents.mts",
    "demo:captures": "playwright test --config playwright.demo.config.ts",
    "charge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tenue-en-charge.mts",
    "classe:creer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/classe-creer.mts",
    "donnees:purger": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/purger-donnees.mts",
    "verifier:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-site.mts",
    "verifier:production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-production.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
