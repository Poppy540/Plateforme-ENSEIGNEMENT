# --- Secrets (voir secrets/README.md) ---
secrets/*.env
!secrets/*.env.example
.env*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# --- Sauvegardes et clé privée age (revue du Jalon 24, S17) : jamais dans git, où qu'elles soient ---
sauvegardes/
*.dump
*.age
cle-sauvegardes*

# --- Données réelles : élèves, parents, candidats (jamais dans git) ---
donnees/
# … sauf le code de l'application (page « Sort des données », ADR 0086) : un dossier de code n'est jamais une donnée.
!application/src/**/donnees/
data/
exports/
**/eleves*.csv
**/parents*.csv
**/candidats*.csv
**/*.donnees-reelles.*

# --- Sorties de tests (peuvent contenir des conversations) ---
tests/resultats/
tests/**/resultats/
agents/*/tests/resultats/

# --- Outils ---
node_modules/
.next/
dist/
build/
coverage/
.DS_Store
.claude/settings.local.json

# Paquet de déploiement (ADR 0076)
/paquet/
